# The home page works without a backend. Account forms require all three values.
# Use a publishable key, NEVER a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Apply migrations and configure the matching auth redirect URLs before use.
# Do not add payment, exchange-rate, mail, or maps keys until providers are chosen.
# Never prefix a privileged key with NEXT_PUBLIC_.
